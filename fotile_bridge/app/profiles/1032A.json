{
  "productId": "1032A",
  "model": "JBSD2T-02-M6Max",
  "name": "洗碗机",
  "powerKey": "PowerSwitchAll",
  "fields": {
    "PowerSwitchAll": {
      "name": "电源（原始值）",
      "icon": "mdi:power",
      "enabled": false
    },
    "WorkState": {
      "name": "工作状态",
      "icon": "mdi:state-machine",
      "values": {
        "0": "已关机",
        "1": "待机",
        "2": "运行中",
        "3": "暂停",
        "4": "已完成"
      }
    },
    "RunState": {
      "name": "运行状态",
      "icon": "mdi:play-circle-outline",
      "values": {
        "0": "停止",
        "1": "运行"
      }
    },
    "WorkMode": {
      "name": "工作模式（原始值）",
      "icon": "mdi:dishwasher",
      "enabled": false
    },
    "AddFunL": {
      "name": "附加功能",
      "icon": "mdi:plus-box-outline",
      "enabled": false
    },
    "StoreTotalTime": {
      "name": "存储总时间",
      "unit": "h",
      "device_class": "duration",
      "icon": "mdi:timer-outline",
      "enabled": false
    },
    "SetAppointmentTime": {
      "name": "预约时间",
      "unit": "min",
      "device_class": "duration",
      "icon": "mdi:clock-outline"
    },
    "SoftensaltLevel": {
      "name": "软水盐档位",
      "icon": "mdi:shaker-outline"
    },
    "DoorLockSta": {
      "name": "门锁（1=已上锁）",
      "entity": "binary_sensor",
      "icon": "mdi:door-closed-lock"
    },
    "Reminder": {
      "name": "提醒",
      "icon": "mdi:bell-outline"
    },
    "ErrorNum": {
      "name": "故障码",
      "icon": "mdi:alert-circle-outline"
    },
    "RemoteAuth": {
      "name": "远程授权",
      "icon": "mdi:shield-key-outline",
      "enabled": false
    },
    "AutoDrain": {
      "name": "自动排水",
      "entity": "binary_sensor",
      "icon": "mdi:water-pump",
      "enabled": false
    },
    "ClRemTime": {
      "name": "剩余时间",
      "unit": "min",
      "device_class": "duration",
      "icon": "mdi:timer-sand"
    },
    "StRemTime": {
      "name": "剩余总时间",
      "unit": "min",
      "device_class": "duration",
      "icon": "mdi:timer-outline"
    },
    "SetWorkTime": {
      "name": "设定工作时间",
      "unit": "min",
      "device_class": "duration",
      "icon": "mdi:clock-digital"
    },
    "GSCPowerSwitch": {
      "name": "蒸汽清洁电源",
      "icon": "mdi:weather-cloudy",
      "enabled": false
    },
    "GSCWorkSta": {
      "name": "蒸汽清洁状态",
      "icon": "mdi:weather-cloudy",
      "enabled": false
    },
    "GSCRunSta": {
      "name": "蒸汽清洁运行",
      "icon": "mdi:play-circle-outline",
      "enabled": false
    },
    "GSCWorkMode": {
      "name": "蒸汽清洁模式",
      "icon": "mdi:weather-cloudy",
      "enabled": false
    },
    "GSCSetWorkT": {
      "name": "蒸汽清洁设定时间",
      "unit": "min",
      "device_class": "duration",
      "icon": "mdi:clock-digital",
      "enabled": false
    },
    "GSCClRemT": {
      "name": "蒸汽清洁剩余时间",
      "unit": "min",
      "device_class": "duration",
      "icon": "mdi:timer-sand",
      "enabled": false
    },
    "GSCDoorLockSta": {
      "name": "蒸汽清洁门锁",
      "entity": "binary_sensor",
      "icon": "mdi:door-closed-lock",
      "enabled": false
    },
    "GSCAutoDrain": {
      "name": "蒸汽清洁自动排水",
      "entity": "binary_sensor",
      "icon": "mdi:water-pump",
      "enabled": false
    },
    "GSCErrorNum": {
      "name": "蒸汽清洁故障码",
      "icon": "mdi:alert-circle-outline",
      "enabled": false
    },
    "ValleyAppoint": {
      "name": "峰谷预约",
      "icon": "mdi:calendar-clock",
      "enabled": false
    },
    "ValleyMode": {
      "name": "峰谷模式",
      "icon": "mdi:transmission-tower",
      "enabled": false
    },
    "ValleyAddFunL": {
      "name": "峰谷附加功能",
      "icon": "mdi:plus-box-outline",
      "enabled": false
    },
    "ValleyStoreTime": {
      "name": "峰谷存储时间",
      "unit": "h",
      "device_class": "duration",
      "icon": "mdi:timer-outline",
      "enabled": false
    },
    "AllowRemoteControl": {
      "name": "允许远程控制",
      "entity": "binary_sensor",
      "icon": "mdi:remote",
      "enabled": false
    },
    "AuthType": {
      "name": "授权类型",
      "icon": "mdi:key-outline",
      "enabled": false
    },
    "NewRemoteAuth": {
      "name": "远程授权类型",
      "icon": "mdi:key-outline",
      "enabled": false
    }
  },
  "commands": {
    "power": {
      "options": {
        "on": {
          "PowerSwitchAll": 1,
          "GSCPowerSwitch": 1
        },
        "off": {
          "PowerSwitchAll": 0,
          "GSCPowerSwitch": 0
        }
      }
    },
    "appointment": {
      "field": "SetAppointmentTime"
    },
    "drain": {
      "experimental": true
    },
    "daily_wash": {
      "button": {
        "name": "日常洗并启动"
      },
      "sequence": [
        {
          "WorkMode": 0,
          "WorkState": 1,
          "AddFunL": 1,
          "StoreTotalTime": 10,
          "PowerSwitchAll": 1
        }
      ]
    },
    "start": {
      "button": {
        "name": "开始/继续"
      },
      "sequence": [
        {
          "WorkState": 1
        }
      ]
    },
    "pause": {
      "button": {
        "name": "暂停"
      },
      "sequence": [
        {
          "WorkState": 2
        }
      ]
    },
    "stop": {
      "button": {
        "name": "取消"
      },
      "sequence": [
        {
          "WorkState": 0
        }
      ]
    }
  },
  "controls": [
    {
      "type": "switch",
      "name": "蒸汽清洁",
      "field": "GSCPowerSwitch",
      "on": 1,
      "off": 0,
      "icon": "mdi:weather-cloudy"
    },
    {
      "type": "number",
      "name": "蒸汽清洁时间(分钟)",
      "field": "GSCSetWorkT",
      "min": 1,
      "max": 120,
      "unit": "min",
      "icon": "mdi:clock-digital"
    },
    {
      "type": "number",
      "name": "保洁存储(天)",
      "field": "StoreTotalTime",
      "min": 1,
      "max": 99,
      "unit": "d",
      "icon": "mdi:timer-outline"
    },
    {
      "type": "number",
      "name": "软水盐档位",
      "field": "SoftensaltLevel",
      "min": 0,
      "max": 10,
      "icon": "mdi:shaker-outline"
    },
    {
      "type": "number",
      "name": "工作模式(原始值)",
      "field": "WorkMode",
      "min": 0,
      "max": 10,
      "icon": "mdi:dishwasher"
    },
    {
      "type": "switch",
      "name": "峰谷模式",
      "field": "ValleyMode",
      "on": 1,
      "off": 0,
      "icon": "mdi:transmission-tower"
    },
    {
      "type": "number",
      "name": "峰谷预约(分钟)",
      "field": "ValleyAppoint",
      "min": 0,
      "max": 1440,
      "unit": "min",
      "icon": "mdi:calendar-clock"
    },
    {
      "type": "number",
      "name": "工作状态(原始值)",
      "field": "WorkState",
      "min": 0,
      "max": 4,
      "icon": "mdi:state-machine"
    }
  ]
}