{
  "productId": "1032A",
  "model": "JBSD2T-02-M6Max",
  "name": "洗碗机",
  "powerKey": "PowerSwitchAll",
  "fields": {
    "PowerSwitchAll": {
      "name": "电源（原始值）",
      "icon": "mdi:power",
      "enabled": false
    },
    "WorkState": {
      "name": "工作状态",
      "icon": "mdi:state-machine",
      "values": {
        "0": "已关机",
        "1": "待机",
        "2": "运行中",
        "3": "暂停",
        "4": "已完成",
        "6": "预约等待"
      },
      "note": "0关机 1待机 2运行 3未确认 4完成 6预约等待"
    },
    "RunState": {
      "name": "运行状态",
      "icon": "mdi:play-circle-outline",
      "values": {
        "0": "停止",
        "1": "运行"
      }
    },
    "WorkMode": {
      "name": "当前程序",
      "icon": "mdi:dishwasher",
      "enabled": true,
      "values": {
        "0": "日常洗",
        "1": "超快洗",
        "2": "超净洗",
        "3": "晶亮洗",
        "4": "自清洁",
        "5": "节能洗",
        "6": "智能洗",
        "128": "预冲洗",
        "129": "母婴洗",
        "130": "静音洗",
        "132": "蒸汽消杀",
        "133": "独立烘干",
        "136": "餐前暖碟"
      }
    },
    "AddFunL": {
      "name": "附加功能",
      "icon": "mdi:plus-box-outline",
      "enabled": false
    },
    "StoreTotalTime": {
      "name": "保洁存储(天)",
      "unit": "d",
      "device_class": "duration",
      "icon": "mdi:calendar-range",
      "enabled": false
    },
    "SetAppointmentTime": {
      "name": "预约启动",
      "icon": "mdi:clock-outline",
      "decode": "hhmm_day",
      "enabled": true,
      "note": "(天数*24+小时)*256+分钟；6144=未设置；decode=hhmm_day"
    },
    "SoftensaltLevel": {
      "name": "软水盐档位",
      "icon": "mdi:shaker-outline",
      "enabled": false
    },
    "DoorLockSta": {
      "name": "门锁（1=已上锁）",
      "entity": "binary_sensor",
      "icon": "mdi:door-closed-lock"
    },
    "Reminder": {
      "name": "提醒",
      "icon": "mdi:bell-outline"
    },
    "ErrorNum": {
      "name": "故障码",
      "icon": "mdi:alert-circle-outline"
    },
    "RemoteAuth": {
      "name": "远程授权",
      "icon": "mdi:shield-key-outline",
      "enabled": false
    },
    "AutoDrain": {
      "name": "自动排水",
      "entity": "binary_sensor",
      "icon": "mdi:water-pump",
      "enabled": false
    },
    "ClRemTime": {
      "name": "剩余时间",
      "unit": "min",
      "device_class": "duration",
      "icon": "mdi:timer-sand",
      "decode": "hhmm",
      "note": "小时*256+分钟；decode=hhmm"
    },
    "StRemTime": {
      "name": "剩余总时间(原始值)",
      "unit": "min",
      "device_class": "duration",
      "icon": "mdi:timer-outline",
      "enabled": false,
      "note": "恒为2040，非倒计时，未确认，保持隐藏"
    },
    "SetWorkTime": {
      "name": "设定工作时间",
      "unit": "min",
      "device_class": "duration",
      "icon": "mdi:clock-digital",
      "decode": "hhmm",
      "note": "小时*256+分钟；decode=hhmm"
    },
    "GSCPowerSwitch": {
      "name": "蒸汽清洁电源",
      "icon": "mdi:weather-cloudy",
      "enabled": false
    },
    "GSCWorkSta": {
      "name": "蒸汽清洁状态",
      "icon": "mdi:weather-cloudy",
      "enabled": false
    },
    "GSCRunSta": {
      "name": "蒸汽清洁运行",
      "icon": "mdi:play-circle-outline",
      "enabled": false
    },
    "GSCWorkMode": {
      "name": "蒸汽清洁模式",
      "icon": "mdi:weather-cloudy",
      "enabled": false
    },
    "GSCSetWorkT": {
      "name": "蒸汽清洁设定时间",
      "unit": "min",
      "device_class": "duration",
      "icon": "mdi:clock-digital",
      "enabled": false,
      "note": "小时*256+分钟，默认18=18分钟"
    },
    "GSCClRemT": {
      "name": "蒸汽清洁剩余时间",
      "unit": "min",
      "device_class": "duration",
      "icon": "mdi:timer-sand",
      "enabled": false,
      "note": "小时*256+分钟"
    },
    "GSCDoorLockSta": {
      "name": "蒸汽清洁门锁",
      "entity": "binary_sensor",
      "icon": "mdi:door-closed-lock",
      "enabled": false
    },
    "GSCAutoDrain": {
      "name": "蒸汽清洁自动排水",
      "entity": "binary_sensor",
      "icon": "mdi:water-pump",
      "enabled": false
    },
    "GSCErrorNum": {
      "name": "蒸汽清洁故障码",
      "icon": "mdi:alert-circle-outline",
      "enabled": false
    },
    "ValleyAppoint": {
      "name": "峰谷预约",
      "icon": "mdi:calendar-clock",
      "enabled": false
    },
    "ValleyMode": {
      "name": "峰谷模式",
      "icon": "mdi:transmission-tower",
      "enabled": false
    },
    "ValleyAddFunL": {
      "name": "峰谷附加功能",
      "icon": "mdi:plus-box-outline",
      "enabled": false
    },
    "ValleyStoreTime": {
      "name": "峰谷存储时间",
      "unit": "h",
      "device_class": "duration",
      "icon": "mdi:timer-outline",
      "enabled": false
    },
    "AllowRemoteControl": {
      "name": "允许远程控制",
      "entity": "binary_sensor",
      "icon": "mdi:remote",
      "enabled": false
    },
    "AuthType": {
      "name": "授权类型",
      "icon": "mdi:key-outline",
      "enabled": false
    },
    "NewRemoteAuth": {
      "name": "远程授权类型",
      "icon": "mdi:key-outline",
      "enabled": false
    }
  },
  "commands": {
    "power": {
      "options": {
        "on": {
          "PowerSwitchAll": 1,
          "GSCPowerSwitch": 1
        },
        "off": {
          "PowerSwitchAll": 0,
          "GSCPowerSwitch": 0
        }
      }
    },
    "appointment": {
      "field": "SetAppointmentTime"
    },
    "drain": {
      "button": {
        "name": "排水"
      },
      "delay_ms": 2000,
      "sequence": [
        {
          "PowerSwitchAll": 0,
          "GSCPowerSwitch": 0
        },
        {
          "AutoDrain": 1
        }
      ]
    },
    "start": {
      "button": {
        "name": "开始/继续"
      },
      "sequence": [
        {
          "WorkState": 1
        }
      ]
    },
    "pause": {
      "button": {
        "name": "暂停"
      },
      "sequence": [
        {
          "WorkState": 2
        }
      ]
    },
    "stop": {
      "button": {
        "name": "取消"
      },
      "sequence": [
        {
          "WorkState": 0
        }
      ]
    },
    "start_program": {
      "button": {
        "name": "启动所选程序"
      },
      "program": true
    }
  },
  "controls": [
    {
      "type": "number",
      "name": "保洁存储(天)",
      "field": "StoreTotalTime",
      "min": 1,
      "max": 99,
      "unit": "d",
      "icon": "mdi:calendar-range",
      "note": "1-99天；部分程序不支持存储，启动时会发0",
      "param": true
    }
  ],
  "programs": {
    "日常洗": {
      "WorkMode": 0,
      "AddFunL": 1,
      "store": true
    },
    "超快洗": {
      "WorkMode": 1,
      "AddFunL": 0,
      "store": false
    },
    "超净洗": {
      "WorkMode": 2,
      "AddFunL": 1,
      "store": true
    },
    "晶亮洗": {
      "WorkMode": 3,
      "AddFunL": 1,
      "store": true
    },
    "自清洁": {
      "WorkMode": 4,
      "AddFunL": 0,
      "store": false
    },
    "节能洗": {
      "WorkMode": 5,
      "AddFunL": 1,
      "store": true
    },
    "智能洗": {
      "WorkMode": 6,
      "AddFunL": 1,
      "store": true
    },
    "预冲洗": {
      "WorkMode": 128,
      "AddFunL": 0,
      "store": false
    },
    "母婴洗": {
      "WorkMode": 129,
      "AddFunL": 1,
      "store": true
    },
    "静音洗": {
      "WorkMode": 130,
      "AddFunL": 1,
      "store": true
    },
    "蒸汽消杀": {
      "WorkMode": 132,
      "AddFunL": 1,
      "store": true
    },
    "独立烘干": {
      "WorkMode": 133,
      "AddFunL": 1,
      "store": true
    },
    "餐前暖碟": {
      "WorkMode": 136,
      "AddFunL": 1,
      "store": true
    }
  },
  "text_controls": [
    {
      "field": "WorkState",
      "name": "工作状态(原始值)"
    }
  ],
  "_notes": {
    "encode_time": "时间字段统一编码：小时*256+分钟。例：286=0x011E=1小时30分=90分钟",
    "encode_appointment": "预约编码：(天数*24+小时)*256+分钟。今天21:00=5376，明天23:30=12062；6144(24:00)兼作未设置（需结合 WorkState 判断）",
    "workstate": "0=关机 1=待机 2=运行 3=未确认 4=完成 6=预约等待",
    "stremtime": "恒为2040，不是倒计时，语义未确认，默认隐藏",
    "decode_kinds": "profile 里 decode 取值：hhmm=时长(小时*256+分)；hhmm_time=时间点；hhmm_day=带天偏移的预约"
  }
}